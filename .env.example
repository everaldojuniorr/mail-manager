# PostgreSQL (local docker-compose.dev.yml)
DATABASE_URL=postgresql://mail:mail@localhost:5432/mail_manager?schema=public

# NestJS API
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
PORT=3001
MAIL_DOMAIN=financyexpert.com

# React (Vite) — leave unset locally to use the /api Vite proxy.
# In Docker production the image builds with VITE_API_URL= (same origin).
# VITE_API_URL=http://localhost:3001

# CORS / SPA origin in production
WEB_ORIGIN=https://webmail.financyexpert.com

# local = só Postgres (dev). smtp = docker-mailserver na VPS
MAIL_PROVIDER=local
IMAP_HOST=mail.financyexpert.com
IMAP_PORT=993
IMAP_SECURE=true
SMTP_HOST=mail.financyexpert.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@financyexpert.com
SMTP_PASS=troque-pela-senha-da-conta-no-mailserver
