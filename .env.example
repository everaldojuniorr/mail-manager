# PostgreSQL (local docker-compose)
DATABASE_URL=postgresql://mail:mail@localhost:5432/mail_manager?schema=public

# NestJS API
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
PORT=3001
MAIL_DOMAIN=example.com

# React (Vite) — proxy usa /api no dev; em produção aponte para a API
VITE_API_URL=http://localhost:3001

# Fase 2 (VPS) — deixe MAIL_PROVIDER=local no desenvolvimento
MAIL_PROVIDER=local
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_SECURE=true
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
