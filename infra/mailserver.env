# Copie e ajuste para o seu domínio real antes do deploy na VPS.
OVERRIDE_HOSTNAME=mail.example.com
LOG_LEVEL=info
ONE_DIR=1
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=1
ENABLE_SPAMASSASSIN=0
ENABLE_POSTGREY=0
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
SSL_TYPE=letsencrypt
PERMIT_DOCKER=connected-networks
SPOOF_PROTECTION=1
POSTFIX_MESSAGE_SIZE_LIMIT=10240000
